{
  "name": "kb-assistant",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Atlas Logistics knowledge assistant: a portfolio demo of RAG, agentic retrieval, AI governance and measured productivity.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check:corpus": "tsx scripts/check-corpus.ts",
    "ingest": "tsx scripts/ingest.ts",
    "probe": "tsx scripts/probe-retrieval.ts",
    "try": "tsx scripts/try-ask.ts",
    "eval": "tsx scripts/run-eval.ts",
    "seed:usage": "tsx scripts/seed-usage.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
